# Copie ce fichier en `.env` pour configurer NEXUS (le fichier .env n'est jamais versionné).

# Clé API Anthropic — optionnel : tu peux aussi la saisir dans Réglages (stockée dans data/secrets.json).
# ANTHROPIC_API_KEY=sk-ant-...

# Ports (par défaut 4317 pour l'API, 5317 pour l'interface en développement)
# NEXUS_PORT=4317
# NEXUS_WEB_PORT=5317

# Dossier des données (par défaut ./data)
# NEXUS_DATA_DIR=./data
