{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS — système d'exploitation personnel augmenté par l'IA",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production NODE_OPTIONS=--no-warnings=ExperimentalWarning tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run",
    "test:watch": "vitest",
    "seed": "NODE_OPTIONS=--no-warnings=ExperimentalWarning tsx server/db/seed-cli.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.9",
    "@tanstack/react-query": "^5.108.0",
    "d3-force": "^3.0.1",
    "hono": "^4.13.19",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
